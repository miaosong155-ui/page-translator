{
  "manifest_version": 3,
  "name": "整页翻译 · Page Translator",
  "version": "1.0.1",
  "description": "一键把整个网页翻译成中文（或英日韩等多语种），保留原版式，随时还原原文。免注册、免 API Key。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "翻译此页",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*",
    "https://transmart.qq.com/*",
    "https://api.mymemory.translated.net/*",
    "https://translate.googleapis.com/*"
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "翻译 / 还原当前页面"
    }
  }
}
